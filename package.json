{
  "name": "famiteam",
  "version": "1.0.0",
  "private": true,
  "description": "FamiTeam — application familiale gamifiée (vanilla JS, Supabase)",
  "scripts": {
    "test": "node test/run.js",
    "cap:copy": "node scripts/sync-www.mjs",
    "vendor:supabase": "node scripts/vendorer-supabase.mjs",
    "vendor:pdf": "node scripts/vendorer-pdf.mjs",
    "cap:sync": "npm run cap:copy && cap sync",
    "icon:generer": "node scripts/generer-icone.mjs && capacitor-assets generate --android --ios",
    "android:maj": "git pull --ff-only && npm install && npm run cap:sync && cap run android",
    "android:apk": "npm run cap:sync && cap build android"
  },
  "dependencies": {
    "@capacitor-community/file-opener": "^8.0.1",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.0",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/share": "^8.0.1",
    "@ebarooni/capacitor-calendar": "^8.3.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/ios": "^8.5.0",
    "@supabase/supabase-js": "^2.112.3",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "sharp": "^0.35.3"
  }
}
